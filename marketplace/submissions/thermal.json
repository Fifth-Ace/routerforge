{
  "schema_version": 1,
  "id": "thermal",
  "kind": "module",
  "name": "Thermal Monitor",
  "category": "Monitoring",
  "description": "Thermal/hwmon датчики, Wi‑Fi temperature и optional SMART temperature.",
  "publisher": {
    "id": "routerforge",
    "name": "RouterForge",
    "url": "https://github.com/Fifth-Ace/dns-monitor"
  },
  "project_url": "https://github.com/Fifth-Ace/dns-monitor",
  "source": "routerforge-official",
  "managed": true,
  "package_authoritative": true,
  "detection": {
    "packages": [
      "routerforge-thermal",
      "dns-monitor-thermal"
    ],
    "services": [
      "/opt/etc/init.d/S93routerforge-thermal",
      "/opt/etc/init.d/S93dns-monitor-thermal"
    ]
  },
  "compatibility": {
    "status": "requirements",
    "hints": [
      "RouterForge Core",
      "Entware",
      "Keenetic / Netcraze ARM64"
    ]
  },
  "install": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-thermal"
    ],
    "notes": [
      "Скачивается только выбранный IPK из GitHub release RouterForge.",
      "SHA256 проверяется до opkg install; временный IPK удаляется после операции."
    ],
    "preview_only": false
  },
  "update": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-thermal"
    ],
    "notes": [
      "Обновление beta-канала мигрирует legacy dns-monitor-* package на RouterForge namespace при необходимости."
    ],
    "preview_only": false
  },
  "remove": {
    "method": "structured",
    "packages": [
      "routerforge-thermal",
      "dns-monitor-thermal"
    ],
    "notes": [
      "Удаляются RouterForge package и legacy-предшественник, если он ещё установлен."
    ],
    "preview_only": false,
    "steps": [
      {
        "type": "opkg-remove",
        "packages": [
          "routerforge-thermal"
        ],
        "ignore_failure": true
      },
      {
        "type": "opkg-remove",
        "packages": [
          "dns-monitor-thermal"
        ],
        "ignore_failure": true
      }
    ]
  },
  "presentation": {
    "dashboard": {
      "enabled": true,
      "priority": 40
    }
  },
  "process_names": [
    "routerforge-thermal",
    "dnsmon-thermal"
  ],
  "capabilities": [
    "thermal",
    "hwmon",
    "wifi-thermal",
    "smart-temperature"
  ]
}
