        ],
        "paths": [
          "/opt/etc/nfqws_web.conf"
        ]
      },
      "web_port": 90,
      "web_port_source": "project-default",
      "compatibility": {
        "status": "requirements",
        "hints": [
          "Entware",
          "nfqws or nfqws2",
          "php8-cgi",
          "lighttpd"
        ]
      },
      "install": {
        "method": "structured",
        "packages": [
          "nfqws-keenetic-web"
        ],
        "notes": [
          "Шаги повторяют README nfqws-keenetic-web для Keenetic/Netcraze."
        ],
        "preview_only": false,
        "steps": [
          {
            "type": "opkg-update"
          },
          {
            "type": "opkg-install",
            "packages": [
              "ca-certificates",
              "wget-ssl"
            ]
          },
          {
            "type": "opkg-remove",
            "packages": [
              "wget-nossl"
            ],
            "ignore_failure": true
          },
          {
            "type": "write-opkg-feed",
            "path": "/opt/etc/opkg/nfqws-keenetic-web.conf",
            "content": "src/gz nfqws-keenetic-web https://nfqws.github.io/nfqws-keenetic-web/all"
          },
          {
            "type": "opkg-update"
          },
          {
            "type": "opkg-install",
            "packages": [
              "nfqws-keenetic-web"
            ]
          }
        ]
      },
      "update": {
        "method": "structured",
        "packages": [
