#!/bin/sh
set -eu
mkdir -p /opt/etc/routerforge /opt/var/run
rm -f /opt/var/run/routerforge-network-tools.sock
if [ -x /opt/etc/init.d/S97routerforge-network-tools ]; then
    /opt/etc/init.d/S97routerforge-network-tools stop >/dev/null 2>&1 || true
    /opt/etc/init.d/S97routerforge-network-tools start >/dev/null 2>&1 || true
fi
exit 0
