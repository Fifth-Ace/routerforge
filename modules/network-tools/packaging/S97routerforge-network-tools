#!/bin/sh
# RF cooperative OPKG: the package manager retains FD 3; service daemons must not.
if [ "${RF_APP_TRANSACTION_LEASE_FD:-}" = 3 ]; then
    exec 3>&-
    unset RF_APP_TRANSACTION_LEASE_FD RF_APP_TRANSACTION_PROFILING_INTENT
fi
ENABLED=no
PROCS=routerforge-network-tools
ARGS="-socket /opt/var/run/routerforge-network-tools.sock -ui /opt/share/routerforge/modules/network-tools/ui"
PREARGS=""
DESC="RouterForge Network Tools"
PATH=/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin
[ -f /opt/etc/routerforge/module-abi-v1 ] && ENABLED=yes
[ -f /opt/etc/routerforge/modules-disabled/network-tools ] && ENABLED=no
. /opt/etc/init.d/rc.func
