                    "checksum_url":  "https://github.com/Fifth-Ace/routerforge/releases/download/routerforge-dev/routerforge-dev-SHA256SUMS",
                    "asset_template":  "{package}_{version}_aarch64-3.10.ipk",
                    "packages":  [
                                     "routerforge-dns-router"
