{
  "id": "dns-router",
  "kind": "module",
  "name": "DNS Router",
  "category": "DNS",
  "description": "Lightweight DNS router with domain lists, live diagnostics and optional opt-in system DNS Gate for LAN.",
  "publisher": {
    "id": "routerforge",
    "name": "RouterForge",
    "url": "https://github.com/Fifth-Ace/routerforge"
  },
  "project_url": "https://github.com/Fifth-Ace/routerforge",
  "source": "routerforge-official",
  "managed": true,
  "package_authoritative": true,
  "detection": {
    "packages": [
      "routerforge-dns-router"
    ],
    "services": [
      "/opt/etc/init.d/S95routerforge-dns-router"
    ]
  },
  "compatibility": {
    "status": "requirements",
    "hints": [
      "RouterForge Core",
      "Entware",
      "Keenetic / Netcraze ARM64"
    ]
  },
  "install": {
    "method": "routerforge-release",
    "repository": "routerforge-dev",
    "repository_url": "https://github.com/Fifth-Ace/routerforge/releases/download/routerforge-dev",
    "checksum_url": "https://github.com/Fifth-Ace/routerforge/releases/download/routerforge-dev/routerforge-dev-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-dns-router"
    ],
    "notes": [
      "DEV: system DNS Gate is OFF until user explicitly enables it; Keenetic DNS remains untouched by installation."
    ],
    "preview_only": false
  },
  "update": {
    "method": "routerforge-release",
    "repository": "routerforge-dev",
    "repository_url": "https://github.com/Fifth-Ace/routerforge/releases/download/routerforge-dev",
    "checksum_url": "https://github.com/Fifth-Ace/routerforge/releases/download/routerforge-dev/routerforge-dev-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-dns-router"
    ],
    "notes": [
      "DEV: Gate disabled during upgrade; client DNS uses Keenetic until explicitly re-enabled."
    ],
    "preview_only": false
  },
  "remove": {
    "method": "opkg",
    "packages": [
      "routerforge-dns-router"
    ],
    "preview_only": false
  },
  "presentation": {
    "dashboard": {
      "enabled": true,
      "priority": 65
    },
    "navigation": {
      "label": "DNS Router",
      "href": "/modules?module=dns-router",
      "order": 35
    }
  },
  "capabilities": [
    "dns-policy-routing",
    "manual-shadow",
    "dns-diagnostics",
    "opt-in-system-dns-gate"
  ],
  "schema_version": 1
}
