                                               ],
                                     "compatibility":  [
                                                           "Stable is published only for ARM64 (aarch64-3.10).",
                                                           "MIPS/MipSel remain experimental Beta-only targets until physical hardware validation."
                                                       ],
                                     "technical":  [
                                                       "ARM64 production executables are packed with UPX 5.2.1 and verified with upx -t.",
