{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routerforge.local/schema/marketplace-manifest-v1.json",
  "title": "RouterForge App Center Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "publisher"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,80}$"
    },
    "kind": {
      "enum": [
        "module",
        "integration"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "project_url": {
      "type": "string"
    },
    "package_authoritative": {
      "type": "boolean"
    },
    "version_source": {
      "enum": [
        "opkg",
        "binary",
        "service",
        "file",
        "manual",
        "release-index"
      ]
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9+._-]{1,120}$"
      }
    },
    "web": {
      "type": "object",
      "required": [
        "port"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\r\\n]*$"
        },
        "embed": {
          "type": "boolean"
        }
      }
    },
    "detection": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9+._-]{1,120}$"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "navigation": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string",
              "pattern": "^/"
            },
            "order": {
              "type": "integer"
            }
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "priority": {
              "type": "integer"
            }
          }
        }
      }
    },
    "install": {
      "$ref": "#/$defs/plan"
    },
    "update": {
      "$ref": "#/$defs/plan"
    },
    "remove": {
      "$ref": "#/$defs/plan"
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "routerforge-release",
            "opkg",
            "structured",
            "manual",
            "official-script",
            "release-deploy"
          ]
        },
        "repository": {
          "type": "string"
        },
        "repository_url": {
          "type": "string"
        },
        "checksum_url": {
          "type": "string"
        },
        "asset_template": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview_only": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
