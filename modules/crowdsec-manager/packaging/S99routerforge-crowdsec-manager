#!/bin/sh
# RF cooperative OPKG: the package manager retains FD 3; service daemons must not.
if [ "${RF_APP_TRANSACTION_LEASE_FD:-}" = 3 ]; then
    exec 3>&-
    unset RF_APP_TRANSACTION_LEASE_FD RF_APP_TRANSACTION_PROFILING_INTENT
fi
ENABLED=yes
PROCS=routerforge-crowdsec-manager
ARGS="-socket /opt/var/run/routerforge-crowdsec-manager.sock -ui /opt/share/routerforge/modules/crowdsec-manager/ui"
PREARGS=""
DESC="RouterForge CrowdSec Manager"
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
. /opt/etc/init.d/rc.func
