{
  "schema_version": 1,
  "id": "profiling",
  "kind": "module",
  "name": "Profiling",
  "category": "Development",
  "description": "Опциональный pprof Core listener на loopback и slow-request logging.",
  "publisher": {
    "id": "routerforge",
    "name": "RouterForge",
    "url": "https://github.com/Fifth-Ace/dns-monitor"
  },
  "project_url": "https://github.com/Fifth-Ace/dns-monitor",
  "source": "routerforge-official",
  "managed": true,
  "package_authoritative": true,
  "detection": {
    "packages": [
      "dns-monitor-profiling"
    ],
    "paths": [
      "/opt/etc/dns-monitor/profiling.enabled"
    ]
  },
  "compatibility": {
    "status": "requirements",
    "hints": [
      "RouterForge Core",
      "loopback-only listener",
      "SSH tunnel for remote access"
    ]
  },
  "install": {
    "method": "routerforge-release",
    "repository": "routerforge-dev",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-dev",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-dev/routerforge-dev-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "dns-monitor-profiling"
    ],
    "notes": [
      "Скачивается только выбранный IPK из GitHub release RouterForge.",
      "SHA256 проверяется до opkg install; временный IPK удаляется после операции."
    ],
    "preview_only": false
  },
  "update": {
    "method": "routerforge-release",
    "repository": "routerforge-dev",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-dev",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-dev/routerforge-dev-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "dns-monitor-profiling"
    ],
    "notes": [
      "Обновление dev-канала выполняет verified force-reinstall текущего RouterForge build."
    ],
    "preview_only": false
  },
  "remove": {
    "method": "opkg",
    "packages": [
      "dns-monitor-profiling"
    ],
    "notes": [
      "Удаляется только package; RouterForge Core остаётся независимым."
    ],
    "preview_only": false
  },
  "running_paths": [
    "/opt/etc/dns-monitor/profiling.enabled"
  ]
}
