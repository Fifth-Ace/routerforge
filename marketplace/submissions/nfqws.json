{
  "schema_version": 1,
  "id": "nfqws",
  "kind": "integration",
  "name": "nfqws",
  "category": "DPI / Bypass",
  "description": "Классическая ветка nfqws для Keenetic. Для новых установок предпочтительнее nfqws2.",
  "publisher": {
    "id": "nfqws",
    "name": "nfqws",
    "url": "https://github.com/nfqws"
  },
  "project_url": "https://github.com/nfqws/nfqws-keenetic",
  "source": "project-official",
  "detection": {
    "packages": [
      "nfqws-keenetic"
    ],
    "services": [
      "/opt/etc/init.d/S51nfqws",
      "/opt/etc/init.d/S99zapret"
    ],
    "paths": [
      "/opt/etc/nfqws"
    ]
  },
  "process_names": [
    "nfqws"
  ],
  "web_port": 90,
  "web_port_source": "nfqws-keenetic-web",
  "web_requires_package": "nfqws-keenetic-web",
  "compatibility": {
    "status": "requirements",
    "hints": [
      "Entware",
      "Netfilter kernel modules",
      "Legacy branch"
    ]
  },
  "install": {
    "method": "manual",
    "notes": [
      "Legacy integration: Marketplace only detects it."
    ],
    "preview_only": true
  }
}
