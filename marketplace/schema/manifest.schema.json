{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routerforge.local/schema/marketplace-manifest-v1.json",
  "title": "RouterForge App Center Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "publisher"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,80}$"
    },
    "kind": {
      "enum": [
        "module",
        "integration"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      }
    },
    "project_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "managed": {
      "type": "boolean"
    },
    "builtin": {
      "type": "boolean"
    },
    "package_authoritative": {
      "type": "boolean"
    },
    "version_source": {
      "enum": [
        "opkg",
        "binary",
        "service",
        "file",
        "manual",
        "release-index"
      ]
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9+._-]{1,120}$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "process_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "running_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "web_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "web_port_source": {
      "type": "string"
    },
    "web_requires_package": {
      "type": "string",
      "pattern": "^[a-z0-9+._-]{1,120}$"
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "mode"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\r\\n]*$"
        },
        "mode": {
          "enum": [
            "external-only",
            "probe-required",
            "embedded-supported",
            "unsupported-version"
          ]
        },
        "embed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "embed"
            ],
            "properties": {
              "embed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "embedded-supported",
                  "probe-required"
                ]
              }
            }
          }
        }
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9+._-]{1,120}$"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "all",
              "aarch64-3.10",
              "mips-3.4",
              "mipsel-3.4"
            ]
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string",
              "pattern": "^/"
            },
            "order": {
              "type": "integer"
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "priority": {
              "type": "integer"
            }
          }
        }
      }
    },
    "install": {
      "$ref": "#/$defs/plan"
    },
    "update": {
      "$ref": "#/$defs/plan"
    },
    "remove": {
      "$ref": "#/$defs/plan"
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "opkg-update",
            "opkg-install",
            "opkg-upgrade",
            "opkg-remove",
            "write-opkg-feed"
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9+._-]{1,120}$"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "ignore_failure": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "write-opkg-feed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path",
              "content"
            ]
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "routerforge-release",
            "opkg",
            "structured",
            "manual",
            "official-script",
            "release-deploy"
          ]
        },
        "repository": {
          "type": "string"
        },
        "repository_url": {
          "type": "string"
        },
        "installer_url": {
          "type": "string"
        },
        "checksum_url": {
          "type": "string"
        },
        "asset_template": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9+._-]{1,120}$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview_only": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "structured"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}