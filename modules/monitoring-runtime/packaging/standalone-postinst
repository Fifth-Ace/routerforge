#!/bin/sh
set -eu

mkdir -p /opt/etc/routerforge /opt/var/run

# Prototype package installation is intentionally non-disruptive.  The
# standalone service is not auto-enabled or auto-started while the four legacy
# packages remain the production topology.  Hardware A/B starts the exact
# prototype binary under explicit test control.
echo "routerforge-monitoring: standalone prototype installed; autostart disabled until migration/cutover"
exit 0
