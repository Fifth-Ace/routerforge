#!/bin/sh
set -eu
# Git for Windows and POSIX. Enforce identities on each NEW outgoing commit.
expected='Fifth-Ace|248300012+Fifth-Ace@users.noreply.github.com|Fifth-Ace|248300012+Fifth-Ace@users.noreply.github.com'
remote_name="${1:-}"
[ "$remote_name" = origin ] || { echo "RF_IDENTITY: ONLY_ORIGIN" >&2; exit 1; }
count=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case "$remote_ref" in
      refs/heads/dev) ;;
      refs/heads/main)
        [ "${ROUTERFORGE_ALLOW_MAIN_PUSH:-}" = 'yes-explicit-main' ] || { echo 'RF_IDENTITY: MAIN_PUSH_FORBIDDEN' >&2; exit 1; }
        ;;
      *) echo "RF_IDENTITY: REF_FORBIDDEN: $remote_ref" >&2; exit 1 ;;
    esac
    case "$local_ref" in refs/heads/dev|refs/heads/main|HEAD) ;; *) echo "RF_IDENTITY: LOCAL_REF_FORBIDDEN: $local_ref" >&2; exit 1;; esac
    [ "${remote_sha#0000000000000000000000000000000000000000}" != '' ] || { echo 'RF_IDENTITY: NEW_REF_FORBIDDEN' >&2; exit 1; }
    [ "${local_sha#0000000000000000000000000000000000000000}" != '' ] || { echo 'RF_IDENTITY: REF_DELETE_FORBIDDEN' >&2; exit 1; }
    git merge-base --is-ancestor "$remote_sha" "$local_sha" || { echo 'RF_IDENTITY: NON_FAST_FORWARD_FORBIDDEN' >&2; exit 1; }
    for sha in $(git rev-list --reverse "$remote_sha..$local_sha"); do
        actual="$(git show -s --format='%an|%ae|%cn|%ce' "$sha")" || exit 1
        [ "$actual" = "$expected" ] || { echo "RF_IDENTITY: BAD_AUTHOR_OR_COMMITTER: $sha $actual" >&2; exit 1; }
        if git show -s --format='%B' "$sha" | grep -i -E '^[[:space:]]*Co-authored-by[[:space:]]*:' >/dev/null; then
            echo "RF_IDENTITY: COAUTHOR_FORBIDDEN: $sha" >&2
            exit 1
        fi
        count=$((count + 1))
    done
done
[ "$count" -gt 0 ] || { echo 'RF_IDENTITY: EMPTY_OUTGOING_RANGE' >&2; exit 1; }
printf 'RF_IDENTITY_PRE_PUSH: PASS / %s outgoing commits\n' "$count"
