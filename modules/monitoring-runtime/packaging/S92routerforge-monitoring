#!/bin/sh
ENABLED=no
PROCS=routerforge-monitoring
ARGS="-module all -socket-dir /opt/var/run"
PREARGS=""
DESC="RouterForge Monitoring"
PATH=/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Standalone Module ABI v1 service, intentionally outside Core like routerforge-dns.
# Phase 7B prototype is fail-closed at boot: explicit activation is required so
# it can never race legacy S92-S95 helpers for the compatibility sockets.
if [ -f /opt/etc/routerforge/module-abi-v1 ] && \
   [ -f /opt/etc/routerforge/monitoring.prototype-enabled ]; then
    ENABLED=yes
fi

. /opt/etc/init.d/rc.func
