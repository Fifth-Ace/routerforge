{
  "schema_version": 1,
  "id": "admin",
  "kind": "module",
  "name": "RouterForge Control",
  "category": "Administration",
  "description": "Управление и инспекция процессов, listening sockets, Entware services и пакетов без дублирования системной телеметрии.",
  "publisher": {
    "id": "routerforge",
    "name": "RouterForge",
    "url": "https://github.com/Fifth-Ace/dns-monitor"
  },
  "project_url": "https://github.com/Fifth-Ace/dns-monitor",
  "source": "routerforge-official",
  "managed": true,
  "package_authoritative": true,
  "detection": {
    "packages": [
      "routerforge-admin",
      "dns-monitor-admin"
    ],
    "services": [
      "/opt/etc/init.d/S91routerforge-admin",
      "/opt/etc/init.d/S91dns-monitor-admin"
    ]
  },
  "compatibility": {
    "status": "requirements",
    "hints": [
      "RouterForge Core",
      "Entware",
      "Keenetic / Netcraze ARM64"
    ]
  },
  "install": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-admin"
    ],
    "notes": [
      "Скачивается только выбранный IPK из GitHub release RouterForge.",
      "SHA256 проверяется до opkg install; временный IPK удаляется после операции."
    ],
    "preview_only": false
  },
  "update": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-admin"
    ],
    "notes": [
      "Обновление beta-канала мигрирует legacy dns-monitor-* package на RouterForge namespace при необходимости."
    ],
    "preview_only": false
  },
  "remove": {
    "method": "structured",
    "packages": [
      "routerforge-admin",
      "dns-monitor-admin"
    ],
    "notes": [
      "Удаляются RouterForge package и legacy-предшественник, если он ещё установлен."
    ],
    "preview_only": false,
    "steps": [
      {
        "type": "opkg-remove",
        "packages": [
          "routerforge-admin"
        ],
        "ignore_failure": true
      },
      {
        "type": "opkg-remove",
        "packages": [
          "dns-monitor-admin"
        ],
        "ignore_failure": true
      }
    ]
  },
  "presentation": {
    "dashboard": {
      "enabled": true,
      "priority": 40
    },
    "navigation": {
      "label": "Управление",
      "href": "/manage",
      "order": 40
    }
  },
  "process_names": [
    "routerforge-admin",
    "dnsmon-admin"
  ],
  "capabilities": [
    "processes",
    "ports",
    "services",
    "packages"
  ]
}
