{
    "id":  "dns-router",
    "kind":  "module",
    "name":  "DNS Policy Router 2.0",
    "category":  "DNS",
    "description":  "DEV Preview: DNS rules, diagnostics and manual shadow mode; no router DNS takeover.",
    "publisher":  {
                      "id":  "routerforge",
                      "name":  "RouterForge",
                      "url":  "https://github.com/Fifth-Ace/routerforge"
                  },
    "project_url":  "https://github.com/Fifth-Ace/routerforge",
    "source":  "routerforge-official",
    "managed":  true,
    "package_authoritative":  true,
    "detection":  {
                      "packages":  [
                                       "routerforge-dns-router"
                                   ],
                      "services":  [
                                       "/opt/etc/init.d/S95routerforge-dns-router"
                                   ]
                  },
    "compatibility":  {
                          "status":  "requirements",
