{
  "schema_version": 1,
  "id": "storage",
  "kind": "module",
  "name": "Storage Monitor",
  "category": "Monitoring",
  "description": "Файловые системы, block devices и пассивные I/O rates.",
  "publisher": {
    "id": "routerforge",
    "name": "RouterForge",
    "url": "https://github.com/Fifth-Ace/dns-monitor"
  },
  "project_url": "https://github.com/Fifth-Ace/dns-monitor",
  "source": "routerforge-official",
  "managed": true,
  "package_authoritative": true,
  "detection": {
    "packages": [
      "routerforge-storage",
      "dns-monitor-storage"
    ],
    "services": [
      "/opt/etc/init.d/S94routerforge-storage",
      "/opt/etc/init.d/S94dns-monitor-storage"
    ]
  },
  "compatibility": {
    "status": "requirements",
    "hints": [
      "RouterForge Core",
      "Entware",
      "Keenetic / Netcraze ARM64"
    ]
  },
  "install": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-storage"
    ],
    "notes": [
      "Скачивается только выбранный IPK из GitHub release RouterForge.",
      "SHA256 проверяется до opkg install; временный IPK удаляется после операции."
    ],
    "preview_only": false
  },
  "update": {
    "method": "routerforge-release",
    "repository": "routerforge-beta",
    "repository_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta",
    "checksum_url": "https://github.com/Fifth-Ace/dns-monitor/releases/download/routerforge-beta/routerforge-beta-SHA256SUMS",
    "asset_template": "{package}_{version}_aarch64-3.10.ipk",
    "packages": [
      "routerforge-storage"
    ],
    "notes": [
      "Обновление beta-канала мигрирует legacy dns-monitor-* package на RouterForge namespace при необходимости."
    ],
    "preview_only": false
  },
  "remove": {
    "method": "structured",
    "packages": [
      "routerforge-storage",
      "dns-monitor-storage"
    ],
    "notes": [
      "Удаляются RouterForge package и legacy-предшественник, если он ещё установлен."
    ],
    "preview_only": false,
    "steps": [
      {
        "type": "opkg-remove",
        "packages": [
          "routerforge-storage"
        ],
        "ignore_failure": true
      },
      {
        "type": "opkg-remove",
        "packages": [
          "dns-monitor-storage"
        ],
        "ignore_failure": true
      }
    ]
  },
  "presentation": {
    "dashboard": {
      "enabled": true,
      "priority": 40
    }
  },
  "process_names": [
    "routerforge-storage",
    "dnsmon-storage"
  ],
  "capabilities": [
    "mounts",
    "block-devices",
    "diskstats",
    "io-rates"
  ]
}
