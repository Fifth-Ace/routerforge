#!/bin/sh
ENABLED=no
PROCS=routerforge-port-access-manager
SOCKET=/opt/var/run/routerforge-port-access-manager.sock
ARGS="-socket $SOCKET -ui /opt/share/routerforge/modules/port-access-manager/ui"
PREARGS=""
DESC="RouterForge Port Access Manager (read-only)"
PATH=/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin
cleanup_socket() {
    if [ -z "$(pidof "$PROCS" 2>/dev/null)" ]; then
        rm -f "$SOCKET"
    fi
}
case "$1" in stop|kill) trap cleanup_socket 0 ;; esac
[ -f /opt/etc/routerforge/module-abi-v1 ] && ENABLED=yes
[ -f /opt/etc/routerforge/modules-disabled/port-access-manager ] && ENABLED=no
. /opt/etc/init.d/rc.func
